<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="registros">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="usuario" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="xs:integer"></xs:element>
                            <xs:element name="nombre" type="xs:string"></xs:element>
                            <xs:element name="segundoNombre" type="xs:string" minOccurs="0"></xs:element >
                            <xs:element name="apellido" type="xs:string"></xs:element>
                            <xs:element name="correo" type="xs:string"></xs:element>
                        </xs:sequence>
                    </xs:complexType>

                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>